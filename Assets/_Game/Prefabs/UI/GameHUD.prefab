MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9030640765866908471}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2a5916e4cc72fa40bf2941724298f8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DontTrustYourLuck.Runtime::DontTrustYourLuck.Presentation.UI.MainMenuView
  text:
    menuTitle: MAIN MENU
    play: Play
    howToPlay: How to Play
    options: Options
    credits: Credits
    back: Back
    footerHint: Click to select  -  Esc to go back
    footerEvent: Unity Game Jam 2026
    howToTitle: HOW TO PLAY
    howToSteps:
    - '<b>Lucky number</b>: drawn once per match. Land on it <b>exactly</b> to win.'
    - '<b>Unlucky number</b>: changes every round. End a move on it and you are <b>out</b>.'
    - '<b>Your turn</b>: roll two dice and choose <b>one</b> of them to move.'
    - <b>Too far?</b> Extra steps bounce back from the lucky number.
    - '<b>Cards</b>: one per turn. Lucky Roll, Swap, Retreat or Shield.'
    - '<b>Round 15</b>: the closest to the lucky number wins. The last animal standing wins too.'
    optionsTitle: OPTIONS
    creditsTitle: CREDITS
    creditsBody: "<b>Don't Trust Your Luck!</b>\nA party board game made for Unity Game Jam 2026.\n\n<b>Design & development</b>\nandreary1\n\n<b>Built with</b>\nUnity 6 - Universal Render Pipeline\n\n<b>Art & audio</b>\nOriginal art and music made for this project.\nVisual inspiration: Fortaleza, Cear\xE1 (Brazil).\n\n<b>Thanks for playing!</b>"
  showOnStart: 1
